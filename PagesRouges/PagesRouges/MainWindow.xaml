<Window x:Class="PagesRouges.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:PagesRouges"
        xmlns:views="clr-namespace:PagesRouges.View"
        xmlns:viewModel="clr-namespace:PagesRouges.ViewModel"
        mc:Ignorable="d"
        Title="Pages rouges" Height="700" Width="1400"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewModel:MainViewModel/>
    </Window.DataContext>
    <i:Interaction.Triggers>
        <i:KeyTrigger Key="A" Modifiers="Control+Shift">
            <i:InvokeCommandAction Command="{Binding OpenLoginCommand}" />
        </i:KeyTrigger>
    </i:Interaction.Triggers>

    <Window.Resources>

        <DataTemplate DataType="{x:Type viewModel:UsersInfosViewModel}">
            <views:UsersInfosView/>
        </DataTemplate>

    </Window.Resources>
    <Grid>

        <ContentControl Content="{Binding CurrentChildView}"
                        Margin="25"/>

        <Border Background="White"
                BorderBrush="Black"
                BorderThickness="2"
                Padding="20"
                Width="300"
                Height="150"
                Visibility="{Binding IsLoginVisible}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <PasswordBox x:Name="PasswordBox" />
                <Button Content="Valider"
                        Command="{Binding CheckPasswordCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}"
                        Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
