<UserControl x:Class="PagesRouges.View.AdminPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PagesRouges.View"
             xmlns:views="clr-namespace:PagesRouges.View"
             xmlns:viewModel="clr-namespace:PagesRouges.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <DataTemplate DataType="{x:Type viewModel:UserListViewModel}">
            <views:UserListView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:ServicesListViewModel}">
            <views:ServicesListView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:SitesListViewModel}">
            <views:SitesListView/>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBox Text="[Mode admin]"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Background="{StaticResource color2}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton Style="{StaticResource menuButton}" 
                             Tag="{StaticResource whiteColor}"
                             Command="{Binding ShowUsersListCommand}"
                             IsChecked="True"
                             Grid.Column="0">
                    <TextBlock Text="Utilisateurs" 
                               Style="{StaticResource menuButtonText}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource menuButton}" 
                             Tag="{StaticResource whiteColor}"
                             Command="{Binding ShowServicesListCommand}"
                             Grid.Column="1">
                    <TextBlock Text="Services" 
                               Style="{StaticResource menuButtonText}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource menuButton}" 
                             Tag="{StaticResource whiteColor}"
                             Command="{Binding ShowSitesListCommand}"
                             Grid.Column="2">
                    <TextBlock Text="Sites" 
                               Style="{StaticResource menuButtonText}"/>
                </RadioButton>                
            </Grid>
        </StackPanel>

        <ContentControl Content="{Binding CurrentChildChildView}"
                        Margin="25"
                        Grid.Row="2"/>
    </Grid>
</UserControl>
