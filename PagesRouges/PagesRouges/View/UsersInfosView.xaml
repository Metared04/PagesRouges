<UserControl x:Class="PagesRouges.View.UsersInfosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PagesRouges.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBox Text="Rechercher ..."
                     Width="300"
                     Height="30"
                     Grid.Column="0"/>
                <Button Name="searchNameButton"
                    Content="Chercher"
                    Margin="5,0,0,0"
                    Grid.Column="1"/>
                <TextBox Text="Rechercher ..."
                     Width="300"
                     Height="30"
                     Grid.Column="2"/>
                <Button Name="searchSiteButton"
                    Content="Chercher"
                    Margin="5,0,0,0"
                    Grid.Column="3"/>
                <TextBox Text="Rechercher ..."
                     Width="300"
                     Height="30"
                     Grid.Column="4"/>
                <Button Name="searchServiceButton"
                    Content="Chercher"
                    Margin="5,0,0,0"
                    Grid.Column="5"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding CurrentUserList}" 
                  AutoGenerateColumns="False" 
                  HeadersVisibility="Column" 
                  CanUserAddRows="False" 
                  GridLinesVisibility="Horizontal" 
                  Grid.Row="2"
                  FontFamily="Palatino Linotype"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" 
                                    Binding="{Binding Id}" 
                                    Width="*"/>
                    <DataGridTextColumn Header="Nom" 
                                    Binding="{Binding Name}" 
                                    Width="110"/>
                    <DataGridTextColumn Header="Prenom" 
                                    Binding="{Binding FirstName}" 
                                    Width="90"/>
                    <DataGridTextColumn Header="Fixe" 
                                    Binding="{Binding FixNumber}" 
                                    Width="100"/>
                    <DataGridTextColumn Header="Portable" 
                                    Binding="{Binding PhoneNumber}" 
                                    Width="100"/>
                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}" 
                                        Width="190"/>
                    <DataGridTextColumn Header="Service"
                                        Binding="{Binding Service}"
                                        Width="200"/>
                    <DataGridTextColumn Header="Site"
                                        Binding="{Binding Site}"
                                        Width="80"/>
                    <DataGridTemplateColumn Header="Option" 
                                        Width="65">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Voir" 
                                    Command="{Binding DataContext.ShowUserInfosCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" 
                                    Width="60"/>
                                </StackPanel>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

</UserControl>
