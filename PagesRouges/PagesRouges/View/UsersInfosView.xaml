<UserControl x:Class="PagesRouges.View.UsersInfosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PagesRouges.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Nom :"
                                   Grid.Row="0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="1"
                                 Width="100"
                                 Height="20"
                                 Margin="5,0,5,0"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Site :"
                                   Grid.Row="0"/>
                        <ComboBox ItemsSource="{Binding SiteIds}" 
                                  SelectedValue="{Binding SelectedNewUserSiteId, Mode=TwoWay}"
                                  SelectedValuePath="SiteId"
                                  DisplayMemberPath="SiteName"
                                  Margin="5,0,5,0"
                                  Width="75"
                                  Height="20"
                                  Grid.Row="1"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Service :"
                                   Grid.Row="0"/>
                        <ComboBox ItemsSource="{Binding ServiceIds}" 
                                  SelectedValue="{Binding SelectedNewUserServiceId, Mode=TwoWay}"
                                  SelectedValuePath="ServiceId"
                                  DisplayMemberPath="ServiceName"
                                  Margin="5,0,5,0"
                                  Width="75"
                                  Height="20"
                                  Grid.Row="1"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Name="searchUsersButton"
                                Command="{Binding SearchFilteredUserCommand}"
                                Content="Chercher"
                                Margin="5,0,0,0"
                                Grid.Row="1"/>
                    </Grid>
                    
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Name="refreshListButton"
                                Command="{Binding RefreshUserListCommand}"
                                Content="Rafraichir"
                                Margin="5,0,5,0"
                                Grid.Row="1"/>
                    </Grid>                    
                </StackPanel>
                <StackPanel Grid.Column="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Name="createException"
                                Command="{Binding GetExceptionCommand}"
                                Content="Erreur"
                                Margin="5,0,5,0"
                                Grid.Row="1"/>
                    </Grid>
                    
                </StackPanel>
            </Grid>
        </StackPanel>

            <DataGrid ItemsSource="{Binding CurrentUserList}" 
                      AutoGenerateColumns="False" 
                      HeadersVisibility="Column" 
                      CanUserAddRows="False" 
                      GridLinesVisibility="Horizontal" 
                      Grid.Row="2"
                      FontFamily="Palatino Linotype"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" 
                                        Binding="{Binding Id}" 
                                        Width="*"/>
                    <DataGridTextColumn Header="Nom" 
                                    Binding="{Binding Name}" 
                                    Width="110"/>
                    <DataGridTextColumn Header="Prenom" 
                                    Binding="{Binding FirstName}" 
                                    Width="90"/>
                    <DataGridTextColumn Header="Fixe" 
                                    Binding="{Binding FixNumber}" 
                                    Width="100"/>
                    <DataGridTextColumn Header="Portable" 
                                    Binding="{Binding PhoneNumber}" 
                                    Width="100"/>
                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}" 
                                        Width="190"/>
                    <DataGridTextColumn Header="Service"
                                        Binding="{Binding Service}"
                                        Width="200"/>
                    <DataGridTextColumn Header="Site"
                                        Binding="{Binding Site}"
                                        Width="80"/>
                    <DataGridTemplateColumn Header="Option" 
                                        Width="65">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Voir" 
                                    Command="{Binding DataContext.ShowUserInfosCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" 
                                    Width="60"/>
                                </StackPanel>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

</UserControl>
