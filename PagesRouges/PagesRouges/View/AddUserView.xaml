<Window x:Class="PagesRouges.View.AddUserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PagesRouges.View"
        mc:Ignorable="d"
        Title="AddUserView" Height="450" Width="800">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="1"
                    Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Nom :"
                           Grid.Row="0"/>
                <TextBox Margin="45,5,45,5"
                         Grid.Row="1"
                         Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Prenom :"
                           Grid.Row="0"/>
                <TextBox Margin="45,5,45,5"
                         Grid.Row="1"
                         Text="{Binding NewUserFirstName, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Fix (Mettre des '-' pour separer) :"
                           Grid.Row="0"/>
                <TextBox Margin="45,5,45,5"
                         Grid.Row="1"
                         Text="{Binding NewUserFixNumber, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>            
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Portable (Mettre des '-' pour separer) :"
                           Grid.Row="0"/>
                <TextBox Margin="45,5,45,5"
                         Grid.Row="1"
                         Text="{Binding NewUserPhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>            
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBlock Text="Mail :"/>
            <TextBox Margin="45,5,45,5"
                     Text="{Binding NewUserEmail, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Service" 
                           Grid.Row="0"/>
                <ComboBox ItemsSource="{Binding ServiceIds}" 
                          SelectedValue="{Binding SelectedNewUserServiceId, Mode=TwoWay}"
                          SelectedValuePath="ServiceId"
                          DisplayMemberPath="ServiceName"
                          Grid.Row="1"
                          Margin="45,5,45,5"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Site" 
                           Grid.Row="0"/>
                <ComboBox ItemsSource="{Binding SiteIds}" 
                          SelectedValue="{Binding SelectedNewUserSiteId , Mode=TwoWay}"
                          SelectedValuePath="SiteId"
                          DisplayMemberPath="SiteName" 
                          Grid.Row="1"
                          Margin="45,5,45,5"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="6">
            <Button Content="Valider" 
                        Command="{Binding AddNewUserCommand}" 
                        Margin="20, 5, 20, 5"
                        Background="LightGreen"/>
        </StackPanel>
        <StackPanel Grid.Row="6"
                    Grid.Column="1">
            <Button Content="Aleatoire" 
                    Command="{Binding FillWithRandomDataCommand}" 
                    Margin="20, 5, 20, 5"
                    Background="LightCyan"/>
        </StackPanel>

    </Grid>
</Window>
