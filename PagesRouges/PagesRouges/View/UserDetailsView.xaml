<Window x:Class="PagesRouges.View.UserDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PagesRouges.View"
        mc:Ignorable="d"
        Title="UserDetailsView" Height="450" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding NameAndFirstName}" 
                   FontSize="18" 
                   FontWeight="Bold"
                   Foreground="Black"
                   Margin="0,0,0,10"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1" 
                    Orientation="Vertical">
            <TextBlock Text="{Binding Id, StringFormat=ID : {0}}" 
                       Foreground="Black"/>
            <TextBlock Text="{Binding FixNumber, StringFormat=Fix : {0}}" 
                       Foreground="Black"/>
            <TextBlock Text="{Binding PhoneNumber, StringFormat=Mobile : {0}}" 
                       Foreground="Black"/>
            <TextBlock Text="{Binding Email, StringFormat=Mail : {0}}" 
                       Foreground="Black"/>
            <TextBlock Text="{Binding Service, StringFormat=Service : {0}}" 
                       Foreground="Black"/>
            <TextBlock Text="{Binding Site, StringFormat=Site : {0}}" 
                       Foreground="Black"/>
        </StackPanel>
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            
            <Button Content="Exporter en PDF" 
                    Command="{Binding ExportToPdfCommand}" 
                    Width="120"/>
            <Button Content="Fermer" 
                    Command="{Binding CloseCommand}" 
                    Width="80"/>
        </StackPanel>
    </Grid>
</Window>
